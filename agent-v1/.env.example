# NexusClaw AutoCompounder Agent — Environment Configuration
# Copy this file to .env and fill in your values
# NEVER commit your .env file to version control

# Base Mainnet RPC (public endpoint works, private RPC recommended for production)
RPC_URL=https://mainnet.base.org

# Your AGENT wallet private key (never use your main wallet)
# Create a dedicated wallet in MetaMask and export its private key
PRIVATE_KEY_AGENT=0xYOUR_AGENT_WALLET_PRIVATE_KEY_HERE

# NexusClaw Staking Contract (Base Mainnet)
STAKING_ADDRESS=0xD209c27375D1B5916f677F39d5f320E67DD4FaFe

# $NEXUSCLAW Token Contract (Base Mainnet)
TOKEN_ADDRESS=0xFC68E8aEe3A2e717DebBBBd9f6b2Db5Dd3Ed90E6

# Minimum pending reward (in $NEXUSCLAW) before claiming + re-staking
# Lower = more frequent compounding (more gas), higher = less gas
MIN_REWARD_CLAW=1

# How often the agent checks for rewards (in minutes)
POLL_INTERVAL_MINUTES=5
