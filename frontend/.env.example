# NexusClaw Frontend Environment Variables
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=0c7484f5e3caa0f6869087483b55f9d9

# ── Crypto checkout (server-side only, set in Vercel — never NEXT_PUBLIC_) ──
# Account-level xpub from scripts/gen-checkout-wallet.mjs (public key only, cannot spend)
CHECKOUT_XPUB=
# Supabase: NEXT_PUBLIC_SUPABASE_URL must be set; service role key bypasses RLS
SUPABASE_SERVICE_ROLE_KEY=
# Private storage bucket + object path of the bot zip
BOT_BUCKET=releases
BOT_FILE_PATH=NexusClaw-Trader.zip
# Optional: dedicated Base RPC (Alchemy/QuickNode) — recommended for production
BASE_RPC_URL=
