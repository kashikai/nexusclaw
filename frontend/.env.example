# NexusClaw Frontend Environment Variables
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=REPLACE_WITH_CLIENT_PUBLIC_PROJECT_ID

# Server-side kill switch. Blocks County Hunter pages, APIs, bootstrap, mutations and future jobs.
COUNTY_HUNTER_ENABLED=false

# Independent server-side collection kill switch. Discovery and replay remain disabled by default.
COUNTY_HUNTER_DISCOVERY_ENABLED=false

# Browser-visible flag. Controls only navigation and visual discovery of the module.
NEXT_PUBLIC_COUNTY_HUNTER_ENABLED=false

# PUBLIC_BROWSER (County Hunter): use a dedicated project. Production never
# falls back to the generic NexusClaw variables below.
NEXT_PUBLIC_COUNTY_HUNTER_SUPABASE_URL=
NEXT_PUBLIC_COUNTY_HUNTER_SUPABASE_PUBLISHABLE_KEY=

# PUBLIC_BROWSER (legacy NexusClaw): agents, signal-agent and legacy modules only.
# Changing the County Hunter project must not change these values.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Fixed server-side origin used in SIWE messages. Never derive this from Host headers.
COUNTY_HUNTER_AUTH_ORIGIN=

# Browser-visible canonical application origin. Production must match COUNTY_HUNTER_AUTH_ORIGIN.
NEXT_PUBLIC_APP_ORIGIN=

# PRIVATE_SERVER_RUNTIME (County Hunter): required only when the server module
# is enabled. Never prefix it with NEXT_PUBLIC_.
COUNTY_HUNTER_SUPABASE_SECRET_KEY=

# PRIVATE_SERVER_RUNTIME. Production requires postgres; memory is available
# only for local/unit-test adaptation and is rejected by the production gate.
COUNTY_HUNTER_RATE_LIMIT_BACKEND=memory

# PRIVATE_SERVER_RUNTIME. Independent random HMAC secret encoded as at least
# 32 bytes (64+ even hex characters, or standard/base64url with optional
# padding). Never reuse another key.
COUNTY_HUNTER_RATE_LIMIT_SECRET=

# Deprecated staging compatibility for authorized local tooling only. County
# Hunter may read this only outside NODE_ENV=production.
SUPABASE_SECRET_KEY=

# FORBIDDEN_IN_PRODUCTION. Never used by County Hunter runtime.
SUPABASE_SERVICE_ROLE_KEY=

# Set true to reject the legacy fallback during local preflight and provisioning.
COUNTY_HUNTER_STRICT_ADMIN_KEY=false

# Local staging validation only. Never point this value at production or commit it.
COUNTY_HUNTER_STAGING_DB_URL=

# MIGRATION_ONLY. Provide only to a separately authorized administrative job;
# never load it into the normal Next.js runtime.
# COUNTY_HUNTER_PRODUCTION_DB_URL=

# Optional server-only Base RPC used to verify EOA and smart-account SIWE signatures.
COUNTY_HUNTER_BASE_RPC_URL=https://mainnet.base.org

# Optional browser-visible Base RPC. Use a client-safe, origin-restricted endpoint;
# never place a private RPC credential in a NEXT_PUBLIC variable.
NEXT_PUBLIC_BASE_RPC_URL=https://mainnet.base.org
