# NexusClaw Frontend Environment Variables
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=REPLACE_WITH_CLIENT_PUBLIC_PROJECT_ID

# Server-side kill switch. Blocks County Hunter pages, APIs, bootstrap, mutations and future jobs.
COUNTY_HUNTER_ENABLED=false

# Independent server-side collection kill switch. Discovery and replay remain disabled by default.
COUNTY_HUNTER_DISCOVERY_ENABLED=false

# Browser-visible flag. Controls only navigation and visual discovery of the module.
NEXT_PUBLIC_COUNTY_HUNTER_ENABLED=false

# Use the dedicated staging project during validation. Never point staging scripts at production.
NEXT_PUBLIC_SUPABASE_URL=
# County Hunter uses the current public browser key. This value is safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Legacy public key used only by existing NexusClaw flows. County Hunter does not read it.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Fixed server-side origin used in SIWE messages. Never derive this from Host headers.
COUNTY_HUNTER_AUTH_ORIGIN=https://staging.example.invalid

# Browser-visible canonical application origin. Production must match COUNTY_HUNTER_AUTH_ORIGIN.
NEXT_PUBLIC_APP_ORIGIN=https://staging.example.invalid

# Preferred local administrative key for authorized staging provisioning only.
# Never use NEXT_PUBLIC_ and never load it in the deployed frontend runtime.
SUPABASE_SECRET_KEY=

# Legacy/deprecated administrative fallback. Not recommended; remove after strict validation.
SUPABASE_SERVICE_ROLE_KEY=

# Set true to reject the legacy fallback during local preflight and provisioning.
COUNTY_HUNTER_STRICT_ADMIN_KEY=false

# Local staging validation only. Never point this value at production or commit it.
COUNTY_HUNTER_STAGING_DB_URL=

# Optional server-only Base RPC used to verify EOA and smart-account SIWE signatures.
COUNTY_HUNTER_BASE_RPC_URL=https://mainnet.base.org

# Optional browser-visible Base RPC. Use a client-safe, origin-restricted endpoint;
# never place a private RPC credential in a NEXT_PUBLIC variable.
NEXT_PUBLIC_BASE_RPC_URL=https://mainnet.base.org
