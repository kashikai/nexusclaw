# Production pilot template. Every non-boolean value is a placeholder.
# Do not deploy this file and do not place server secrets in NEXT_PUBLIC_*.
NODE_ENV=production

# Both controls fail closed. Enable only after a separate deployment and pilot authorization.
COUNTY_HUNTER_ENABLED=false
COUNTY_HUNTER_DISCOVERY_ENABLED=false
NEXT_PUBLIC_COUNTY_HUNTER_ENABLED=false

# Required only when COUNTY_HUNTER_ENABLED=true. This is the private Next.js
# runtime confirmation, not the separate root administrative runner gate.
COUNTY_HUNTER_PRODUCTION_CONFIRM=REPLACE_WITH_PRODUCTION_PILOT_CONFIRMATION
COUNTY_HUNTER_PRODUCTION_PROJECT_REF=REPLACE_WITH_PRODUCTION_SUPABASE_PROJECT_REF
NEXT_PUBLIC_APP_ORIGIN=
COUNTY_HUNTER_AUTH_ORIGIN=

# PUBLIC_BROWSER: dedicated County Hunter project. These must match
# COUNTY_HUNTER_PRODUCTION_PROJECT_REF when the module is enabled.
NEXT_PUBLIC_COUNTY_HUNTER_SUPABASE_URL=https://REPLACE_WITH_PRODUCTION_PROJECT_REF.supabase.co
NEXT_PUBLIC_COUNTY_HUNTER_SUPABASE_PUBLISHABLE_KEY=REPLACE_WITH_PRODUCTION_PUBLISHABLE_KEY

# PRIVATE_SERVER_RUNTIME: required only when COUNTY_HUNTER_ENABLED=true.
# Store this value in the deployment secret manager, never in Git.
COUNTY_HUNTER_SUPABASE_SECRET_KEY=

# PRIVATE_SERVER_RUNTIME: exact distributed SIWE rate-limit backend.
COUNTY_HUNTER_RATE_LIMIT_BACKEND=postgres

# PRIVATE_SERVER_RUNTIME: independent random HMAC secret encoded as at least
# 32 bytes (64+ even hex characters, or standard/base64url with optional
# padding). Never reuse any
# Supabase, database, WalletConnect, RPC or wallet credential.
COUNTY_HUNTER_RATE_LIMIT_SECRET=

# PUBLIC_BROWSER: existing agents, signal-agent and legacy modules only.
# These values may identify a different Supabase project from County Hunter.
NEXT_PUBLIC_SUPABASE_URL=https://REPLACE_WITH_LEGACY_NEXUSCLAW_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=REPLACE_WITH_LEGACY_NEXUSCLAW_PUBLISHABLE_KEY
NEXT_PUBLIC_SUPABASE_ANON_KEY=REPLACE_ONLY_IF_LEGACY_NEXUSCLAW_FLOWS_REQUIRE_IT
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=REPLACE_WITH_PRODUCTION_WALLETCONNECT_PROJECT_ID
NEXT_PUBLIC_BASE_RPC_URL=https://REPLACE_WITH_CLIENT_SAFE_PRODUCTION_BASE_RPC

# Server-only RPC. It may be private, but must never enter a client component or public bundle.
COUNTY_HUNTER_BASE_RPC_URL=https://REPLACE_WITH_SERVER_ONLY_PRODUCTION_BASE_RPC

# MIGRATION_ONLY: the repository-root .env.production.local is loaded only by
# scripts/validate-county-hunter-production.ps1. Never copy these assignments
# into this frontend file, Vercel, staging, fixtures, or the normal Next.js
# runtime. The runner has explicit -PreflightOnly, -MigrationsOnly and
# -VerifyOnly modes and an exact ten-migration manifest documented in the
# production pilot runbook.
# COUNTY_HUNTER_PRODUCTION_CONFIRM=I_UNDERSTAND_THIS_IS_PRODUCTION
# COUNTY_HUNTER_PRODUCTION_PROJECT_REF=
# COUNTY_HUNTER_PRODUCTION_DB_URL=
# COUNTY_HUNTER_SUPABASE_SECRET_KEY=

# FORBIDDEN_IN_PRODUCTION application runtime:
# SUPABASE_SECRET_KEY= (deprecated staging compatibility only)
# SUPABASE_SERVICE_ROLE_KEY= (legacy/deprecated; not recommended)
# DATABASE_URL
# COUNTY_HUNTER_STAGING_*
# COUNTY_HUNTER_TEST_*
